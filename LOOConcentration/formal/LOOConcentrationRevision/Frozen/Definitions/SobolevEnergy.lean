set_option autoImplicit false
namespace LOOConcentration.Revision
open MeasureTheory Filter
open scoped Topology ENNReal

noncomputable def sobolevEnergy {ι : Type*} [Fintype ι] [DecidableEq ι]
    (μ : Measure (EuclideanSpace ℝ ι)) [IsProbabilityMeasure μ] (u : SobolevPair μ) : ℝ≥0∞ :=
  ∫⁻ x, ‖((WithLp.ofLp u.val).2 : EuclideanSpace ℝ ι → EuclideanSpace ℝ ι) x‖ₑ ^ 2 ∂μ

end LOOConcentration.Revision
